# ============================================================
# Pakish Institute — production environment
# Copy to .env.local (local) or set in Coolify / host secrets.
# ============================================================

# --- Required for live admin email notifications ---
# Create API key at https://resend.com/api-keys
# Verify domain (pakish.org) in Resend before using custom From.
RESEND_API_KEY=
# Use a verified Pakish-owned sending subdomain in production (e.g. notify.pakish.org).
RESEND_FROM_EMAIL=Pakish Institute Admissions <admissions@notify.pakish.org>
ADMISSION_NOTIFY_TO=billing@pakish.org

# --- Required for /admin login ---
# Use a long random string. Same value is the login password unless
# you set ADMIN_PASSWORD separately (optional override).
ADMIN_SECRET=
# ADMIN_PASSWORD=

# Optional aliases
# BILLING_EMAIL=billing@pakish.org
